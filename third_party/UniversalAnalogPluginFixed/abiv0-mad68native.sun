+*.cpp
dynamic
require Soup/soup include_dir=Soup

arg -O2
arg -fno-omit-frame-pointer
arg -DUAP_DISABLE_HOTPLUG=1
arg -DUAP_POLL_SLEEP_MS=0
arg -DUAP_MADLIONS_DISABLE_DIGITAL_ASSIST=1
arg -DUAP_SYNCHRONOUS_POLL=0

arg -DUAP_EXCLUDE_HALLJOY_NATIVE=1
name abiv0-mad68native
arg -DABI_VERSION_TARGET=0
